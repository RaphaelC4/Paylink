# Paylink environment — copy to .env and fill in. Never commit .env.
#
# These values are for the operator (deploy, CLI, scripts). The frontend does
# not read this file; its public values live in frontend/config.js.

# --- NEAR testnet ---
# Contract account (v2: allowlist is Tidepool sandbox USDC), created from the
# faucet:
#   near account create-account sponsor-by-faucet-service paylink-v2.testnet \
#     autogenerate-new-keypair save-to-legacy-keychain
PAYLINK_CONTRACT_ID=paylink-v2.testnet

# Payee / creator account (issues invoices and receives payouts)
PAYLINK_ACCOUNT_ID=

# Payer account (settles invoices)
PAYLINK_PAYER_ID=

# Receives the 0.5% fee at claim. Fixed at init, no setter.
PAYLINK_FEE_ACCOUNT=paylink-fees.testnet

# near-cli-rs stores generated keys under ~/.near-credentials/testnet/<id>.json.
# They are never written into this repository.
# PAYLINK_PRIVATE_KEY=

# --- Test token (NEP-141) on testnet ---
# Tidepool's sandbox USDC: 6 decimals. The faucet drips 100 of it per call
# (https://www.usetidepool.tech), and swaps settle into it.
PAYLINK_TOKEN_ID=usdc.tidepool-sandbox.testnet

# Deposit required by new(): 0.02 NEAR per allowlisted token, because the
# contract registers both itself and the fee account with the token.
PAYLINK_INIT_DEPOSIT=0.02

# --- Tidepool (faucet + swap on the pay page) ---
# Keyless: no secret, no account. Any X-API-Key value only selects a fee
# tier and is hardcoded in frontend/app.js.

# --- Frontend ---
# Public URL of the hosted demo, used for share links
PAYLINK_BASE_URL=http://localhost:8000

# --- Invoice parsing (optional) ---
# Gemini API key (free tier): https://aistudio.google.com/apikey
# Used only by the Cloudflare Worker in workers/parse, as a Worker *secret*.
# Never put this in frontend/config.js.
GEMINI_API_KEY=

# The deployed Worker URL, copied into frontend/config.js as `parseEndpoint`.
# Leave empty to keep the "paste a payment request" block hidden.
PARSE_ENDPOINT=
